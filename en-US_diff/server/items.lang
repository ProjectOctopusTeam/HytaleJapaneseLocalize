Ingredient_Powder_Boom.name = Boom Powder
Ingredient_Fire_Essence.name = Essence of Fire
Ingredient_Fire_Essence.description = <i>This energy once gave form to the dreams of Crucible's artisans. Today it merely lingers in the creatures that dwell amid the desolated volcanic regions.</i>
Ingredient_Ice_Essence.name = Essence of Ice
Ingredient_Ice_Essence.description = <i>When the Outlanders rejected the flame and split from their brethren, they turned instead toward the colder regions and the fragile strength found in the advancing sheets of ice.</i>
Ingredient_Life_Essence.name = Essence of Life
Ingredient_Life_Essence.description = <i>A form of overflowing life energy found in abundance around plant life on Orbis. In great enough concentrations, perhaps it could even bring forth sentience where it was absent before.</i>
Ingredient_Life_Essence_Concentrated.name = Greater Essence of Life
Ingredient_Life_Essence_Concentrated.description = An amalgamation equivalent to <color is="#3e9049">100 Essences of Life</color>.
Ingredient_Lightning_Essence.name = Essence of Lightning
Ingredient_Lightning_Essence.description = <i>Raging storms have proved attractive to many creatures over the centuries. Though the true source of such magic is nowhere to be found, the elementals born from its lingering traces still wander the lands.</i>
Ingredient_Void_Essence.name = Essence of the Void
Ingredient_Void_Essence.description = <i>It's unclear whether creatures of the Void produce this essence, or if its presence is required to sustain their existence. What can be said for certain is that the two are inextricably bound.</i>
Ingredient_Water_Essence.name = Essence of Water
Ingredient_Water_Essence.description = <i>Even fish have a natural affinity for magic. As water filters through their gills, the concentration grows. Perhaps therein lies the secret to the abyssal creatures lurking in Orbis' darkest depths.</i>
