Bench_Memories.description = <i>A faint disembodied voice can be heard in the presence of this statue. Echoes of a being from beyond the barriers. From the original world.</i>
Bench_Salvage.description = Can be used to break down some items into base materials.
Bench_Salvage.name = Salvager's Workbench
Bench_Tannery.description = Used to process raw hides into leather. Upgrading reduces processing times and increases storage capacity.
