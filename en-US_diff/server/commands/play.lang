desc = Toggle server access for play modes
enabled.desc = Whether to enable or disable the access type
lan.desc = Toggle LAN play access
friend.desc = Toggle friend play access
online.desc = Toggle online play access
offlineMode = This command is unavailable when offline. If you wish to use this command, restart in online mode.
singleplayerOnlyPrivate = Private Play can only be enabled/disabled in singleplayer!
singleplayerOnlyLan = LAN Play can only be enabled/disabled in singleplayer!
singleplayerOnlyFriend = Friend Play can only be enabled/disabled in singleplayer!
singleplayerOnlyOpen = Open Play can only be enabled/disabled in singleplayer!
accessDisabledPrivate = Disabled Private Play
accessDisabledLan = Disabled LAN Play
accessDisabledFriend = Disabled Friend Play
accessDisabledOpen = Disabled Open Play
accessEnabledPrivate = Enabled Private Play
accessEnabledLan = Enabled LAN Play
accessEnabledFriend = Enabled Friend Play
accessEnabledOpen = Enabled Open Play
accessAlreadyToggledPrivate = Private Play is already {enabled, select, true {enabled} other {disabled}}
accessAlreadyToggledLan = LAN Play is already {enabled, select, true {enabled} other {disabled}}
accessAlreadyToggledFriend = Friend Play is already {enabled, select, true {enabled} other {disabled}}
accessAlreadyToggledOpen = Open Play is already {enabled, select, true {enabled} other {disabled}}
