desc = Locate biomes, zones, regions, prefabs, and points of interest.
biome.desc = Locate the nearest biome by name.
biome.name.desc = The biome name to search for.
zone.desc = Locate the nearest zone by name.
zone.name.desc = The zone name to search for.
region.desc = Locate the nearest region by name.
region.name.desc = The region name to search for.
prefab.desc = Locate the nearest prefab by name.
prefab.name.desc = The prefab name to search for.
dungeon.desc = Locate the nearest cave dungeon by name.
dungeon.name.desc = The dungeon or cave type name to search for.
dungeon.searchCapped = Stopped searching for "{name}" after checking the nearest candidates. It may exist further away; move closer or retry.
prefab.skip.desc = Skip the first N results (e.g. --skip 1 for the second nearest).
prefab.nearest.desc = List the N nearest matches (e.g. --nearest 5).
prefab.nearestHeader = Found {count, number} nearby {count, plural, one {prefab} other {prefabs}} matching "{name}":
prefab.nearestEntry =   #{index, number}: ({x, number}, {y, number}, {z, number}) - {distance, plural, one {1 block} other {{distance, number} blocks}} away
prefab.skipTooHigh = Only {count, plural, one {1 result} other {{count, number} results}} found, cannot skip {skip, number}.
radius.desc = The maximum search radius in blocks (default: 6400).
invalidRadius = Radius must be between {min, number} and {max, number} blocks.
tp.desc = Teleport to the found location.
tp.chunkUnavailable = Could not determine a safe landing height. Teleport skipped.
searching = Searching...
found2d = Located {type, select, biome {biome} zone {zone} region {region} prefab {prefab} dungeon {dungeon} other {location}} "{name}" at ({x, number}, {z, number}), {distance, plural, one {1 block} other {{distance, number} blocks}} away.
found3d = Located {type, select, biome {biome} zone {zone} region {region} prefab {prefab} dungeon {dungeon} other {location}} "{name}" at ({x, number}, {y, number}, {z, number}), {distance, plural, one {1 block} other {{distance, number} blocks}} away.
notFoundInRadius = No {type, select, biome {biome} zone {zone} region {region} prefab {prefab} dungeon {dungeon} other {location}} matching "{name}" found within {radius, plural, one {1 block} other {{radius, number} blocks}}.
notFoundInWorld = No {type, select, biome {biome} zone {zone} region {region} prefab {prefab} dungeon {dungeon} other {location}} matching "{name}" found in this world.
noGenerator = This world does not use a chunk generator.
noPosition = Could not determine your position.
