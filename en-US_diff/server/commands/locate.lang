desc = [TMP] Locate biomes, zones, regions, prefabs, and points of interest.
biome.desc = [TMP] Locate the nearest biome by name.
biome.name.desc = [TMP] The biome name to search for.
zone.desc = [TMP] Locate the nearest zone by name.
zone.name.desc = [TMP] The zone name to search for.
region.desc = [TMP] Locate the nearest region by name.
region.name.desc = [TMP] The region name to search for.
prefab.desc = [TMP] Locate the nearest prefab by name.
prefab.name.desc = [TMP] The prefab name to search for.
prefab.skip.desc = [TMP] Skip the first N results (e.g., --skip 1 for the second nearest).
prefab.nearest.desc = [TMP] List the N nearest matches (e.g., --nearest 5).
prefab.nearestHeader = [TMP] Found {count, number} nearby {count, plural, one {prefab} other {prefabs}} matching '{name}':
prefab.nearestEntry = [TMP]   #{index, number}: ({x, number}, {y, number}, {z, number}) - {distance, plural, one {1 block} other {{distance, number} blocks}} away
prefab.skipTooHigh = [TMP] Only {count, plural, one {1 result} other {{count, number} results}} found, cannot skip {skip, number}.
radius.desc = [TMP] The maximum search radius in blocks (default: 6400).
invalidRadius = [TMP] Radius must be between {min, number} and {max, number} blocks.
tp.desc = [TMP] Teleport to the found location.
tp.chunkUnavailable = [TMP] Could not determine a safe landing height. Teleport skipped.
searching = [TMP] Searching...
found2d = [TMP] Located {type, select, biome {biome} zone {zone} region {region} prefab {prefab} other {location}} '{name}' at ({x, number}, {z, number}), {distance, plural, one {1 block} other {{distance, number} blocks}} away.
found3d = [TMP] Located {type, select, biome {biome} zone {zone} region {region} prefab {prefab} other {location}} '{name}' at ({x, number}, {y, number}, {z, number}), {distance, plural, one {1 block} other {{distance, number} blocks}} away.
notFoundInRadius = [TMP] No {type, select, biome {biome} zone {zone} region {region} prefab {prefab} other {location}} matching '{name}' found within {radius, plural, one {1 block} other {{radius, number} blocks}}.
notFoundInWorld = [TMP] No {type, select, biome {biome} zone {zone} region {region} prefab {prefab} other {location}} matching '{name}' found in this world.
noGenerator = [TMP] This world does not use a chunk generator.
noPosition = [TMP] Could not determine your position.
