usage.header = {fullyQualifiedName}: {description} \n/{fullyQualifiedName} {listOfRequiredArgs}{requiresConfirmation}{requiredArgs}{optionalArgs}{defaultArgs}{flagArgs}{argTypes}{variants}{subcommands}
usage.requiresConfirmation = \nThis command requires the "--confirm" flag argument to be specified in order to execute, make sure to double-check your command before running it
usage.flagArgs = \nFlag Arguments: {args}
usage.defaultArgs = \nDefault-Value Arguments: {args}
usage.optionalArgs = \nOptional Arguments: {args}
usage.requiredArgs = \nRequired Arguments: {args}
usage.subcommands = {separator}{usage}
usage.subcommandSeparator = \n---------------------------------\n
error.commandCollectionSubcommandNotFound = Could not find subcommand "{subcommand}", did you mean one of these commands?: {suggestions}
error.wrongNumberOfParametersForArgument = The number of argument for argument "{argument}" is not correct. Expected: {expected}, actual: {actual}, Received input: "{input}".
error.noPermissionForCommand = You do not have permission to use this command.
error.noPermissionForOptional = You do not have permission to use the argument "{argument}".
error.unavailableInSingleplayer = This command isn't available in singleplayer.
error.attemptedUnsafe = This command requires the flag argument "--confirm" to be specified as confirmation of your execution of this command.
error.wrongNumberRequiredParameters = The wrong number of required argument was specified. Expected: {expected}, actual: {actual}
error.notAList = You have specified a list of argument values for an argument that does not accept a list. Argument name: {name}.
error.couldNotFindOptionalArgName = Could not find an optional argument with the name or unique abbreviation of "{input}".
error.allArgumentsInListNeedSameLength = All arguments within a list must have the same number of arguments, error: {error}.
error.noOptionalParameterToAddValueTo = Internal Error: Cannot add argument to an optional argument without first creating an optional argument.
error.cantDoublePlaceSpecialTokens = You cannot place special tokens next to each other.
error.endCommandWithOpenList = You cannot end a command with an open list, please close it using "{listEndToken}".
error.tooManyListItems = You cannot specify more than {amount} list items in a list.
error.invalidEscape = Invalid escape at end of string, index {index}.
error.invalidEscapeForSymbol = Invalid escape for the symbol {symbol} at index {index} as part of the command: "{command}".
error.cannotBeginListInsideList = Cannot begin a list from within another list at index {index}.
error.cannotEndListWithoutStarting = Cannot end a list without having started one first at index {index}.
error.unbalancedQuotes = You have began quotes but have not ended them.
error.optionalArgRequiredIf = Optional argument: "{required}" was not specified, but is required since the other optional argument: "{requirer}" has been specified.
error.optionalArgAvailableIf = Optional argument: "{available}" was specified, but is only available if all of the following arguments are specified, which where were not: {required}.
error.optionalArgAvailableIfAbsent = Optional argument: "{available}" was specified, but is only available if all of the following arguments are not specified: {required}.
