markers.list.state.revealed = revealed
markers.list.state.hidden = hidden
markers.list.truncated = Showing the first {shown} of {count} markers
markers.reveal.desc = Reveal a discoverable block map marker to a player
markers.reveal.success = Revealed marker {marker} to {player}
markers.reveal.noChange = Marker {marker} was already revealed to {player}
markers.hide.desc = Hide a discoverable block map marker from a player again
markers.hide.success = Hid marker {marker} from {player}
markers.hide.noChange = Marker {marker} was already hidden from {player}
markers.inview.desc = Reveal the discoverable block map markers you look at
markers.inview.fov.desc = The full angle of the view cone, in degrees
markers.inview.distance.desc = The maximum distance from your eyes, in blocks
markers.inview.hide.desc = Hide the markers in view instead of revealing them
markers.inview.debug.desc = Draw the view cone and the markers in view
