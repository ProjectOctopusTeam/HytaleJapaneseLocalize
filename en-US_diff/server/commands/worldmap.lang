markers.inview.none = No discoverable block map marker in view (fov {fov}, distance {distance})
markers.inview.header = {count} block map markers in view (fov {fov}, distance {distance}):
markers.inview.entry = {id} at {x} {y} {z} - {state}
markers.inview.state.revealed = revealed
markers.inview.state.hidden = hidden
markers.inview.state.noChange = no change
markers.override.desc = Manage the overrides of the map markers
markers.override.marker.desc = The name of the map marker to override
markers.override.value.default = provider default
