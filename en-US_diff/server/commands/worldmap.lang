clearimages = Cleared world map images!
reloadFailed = Failed to reload world map: {error}
markersCleared = Cleared world map markers!
markers.desc = Inspect block map markers and their discovery state
markers.marker.desc = A block map marker ID, or the start of one
markers.argtype.markerId.name = Marker ID
markers.argtype.markerId.usage = The ID of a discoverable block map marker
markers.notFound = No block map marker matches '{marker}'
markers.ambiguous = '{marker}' matches {count} block map markers. Use more of the ID.
markers.notDiscoverable = Marker {marker} is not discoverable, so it is always visible
