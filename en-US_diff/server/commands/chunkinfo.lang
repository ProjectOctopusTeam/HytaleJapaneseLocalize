load.usage = Use the command `/chunk load {chunkX} {chunkZ}` to load the chunk.
serialized = Serialized chunk data to console.
serialized.failed = Failed to serialize chunk. Please check console.
chunk = Chunk {chunkX}, {chunkZ}:\n\
  \tFlags: \n\
    \t\tStart Init: {startInit}\n\
    \t\tInit: {init}\n\
    \t\tNewly Generated: {newlyGenerated}\n\
    \t\tOn Disk: {onDisk}\n\
    \t\tTicking: {ticking}\n\
  \tKeep Loaded: {keepLoaded}\n\
  \tNeeds Saving: {saving}\n\
  \tMetadata:\n\
  \tBlockChunk:\n\
    \t\tNeeds Saving: {savingChunk}
section = \t\tSection {index}:\n
dataType = \t\t\tData Type: {data}\n
sectionInfo = \t\t\tHas Ticking: {ticking}\n\
      \t\t\tIs Solid Air: {solidAir}\n\
      \t\t\tBlock Count: {count}\n\
      \t\t\tBlock Counts: {counts}
