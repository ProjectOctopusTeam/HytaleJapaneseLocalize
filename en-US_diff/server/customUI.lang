triggerVolumeEffectEditor.field.PastePrefab.Prefab.tooltip = [TMP] Specific prefab asset to paste.
triggerVolumeEffectEditor.field.PastePrefab.Position.tooltip = [TMP] Position used when pasting the prefab.
triggerVolumeEffectEditor.field.PastePrefab.AtVolumeOrigin.tooltip = [TMP] Position adds to the volume origin. When off, Position is treated as absolute world coordinates.
triggerVolumeEffectEditor.field.PastePrefab.ShowParticles.tooltip = [TMP] Show block particles when the prefab is pasted.
triggerVolumeEffectEditor.pastePrefab.preview.tooltip = [TMP] Toggle a world-space preview of the prefab at the trigger volume's location.
triggerVolumeEffectEditor.field.ControlDoors.Action.tooltip = [TMP] Door action to apply.
triggerVolumeEffectEditor.field.DamageEntity.Mode.tooltip = [TMP] Damage mode used for the triggering entity.
triggerVolumeEffectEditor.field.DamageEntity.Amount.tooltip = [TMP] Damage amount to apply.
triggerVolumeEffectEditor.field.RunRootInteraction.RootInteraction.tooltip = [TMP] Root interaction asset to run on the triggering entity.
triggerVolumeEffectEditor.field.RunRootInteraction.InteractionType.tooltip = [TMP] Interaction type used for context, cooldowns, and held item selection.
triggerVolumeEffectEditor.field.SetMusic.MusicContainer.tooltip = [TMP] Music container to force for the triggering player.
triggerVolumeEffectEditor.field.SetMusic.ClearMusic.tooltip = [TMP] Clear this player's forced music and resume world or ambience music.
triggerVolumeEffectEditor.field.GiveItem.Item.tooltip = [TMP] Item asset to grant to the triggering player.
triggerVolumeEffectEditor.field.GiveItem.Quantity.tooltip = [TMP] Number of items to grant. Values below 1 are ignored.
triggerVolumeEffectEditor.field.GiveItem.OverflowBehavior.tooltip = [TMP] What to do when the player's inventory cannot fit the full quantity.
triggerVolumeEffectEditor.field.SetGameMode.GameMode.tooltip = [TMP] Game mode to set for the triggering player.
triggerVolumeEffectEditor.field.common.MatchKey.tooltip = [TMP] Tag key to match against. Leave blank to target this volume only.
triggerVolumeEffectEditor.field.common.MatchValue.tooltip = [TMP] Optional value required under Match Tag Key. Blank matches any value for that key.
triggerVolumeEffectEditor.field.common.Radius.tooltip = [TMP] Maximum distance from the chosen center. 0 searches the entire world.
triggerVolumeEffectEditor.field.common.Center.tooltip = [TMP] Center position used for the radius search.
triggerVolumeEffectEditor.field.ModifyTags.Operation.tooltip = [TMP] How to change the tag on each matched volume. Set and Replace write Tag Value, Remove deletes the key when Tag Value is blank or only removes a matching value, Increment adds a positive or negative number, and Toggle flips true/false.
triggerVolumeEffectEditor.field.ModifyTags.TagKey.tooltip = [TMP] Tag key to modify on each matched volume.
triggerVolumeEffectEditor.field.ModifyTags.TagValue.tooltip = [TMP] Value to write, add, or compare. Blank with Set or Replace stores Empty. Blank with Remove deletes the key regardless of its current value.
triggerVolumeEffectEditor.field.ModifyTags.MatchKey.tooltip = [TMP] Optional tag key used to choose affected volumes. Blank affects this volume.
triggerVolumeEffectEditor.field.ModifyTags.MatchValue.tooltip = [TMP] Optional value required under Match Tag Key. Blank matches any value for that key.
triggerVolumeEffectEditor.field.PlaceBlock.BlockType.tooltip = [TMP] Block type asset to place.
triggerVolumeEffectEditor.field.PlaceBlock.Position.tooltip = [TMP] Position offset or absolute world position, depending on Origin.
