triggerVolumeEffectEditor.field.Teleport.Position.tooltip = [TMP] Destination position for the entity. When Relative to Entity is enabled, this is added as a world-space offset from the triggering entity.
triggerVolumeEffectEditor.field.Teleport.World.tooltip = [TMP] Optional destination world. Leave empty to use the current world.
triggerVolumeEffectEditor.field.Teleport.ResetVelocity.tooltip = [TMP] Reset entity velocity after teleporting.
triggerVolumeEffectEditor.field.Teleport.RelativeToEntity.tooltip = [TMP] Add Position to the triggering entity's current world position instead of using Position as an absolute destination.
triggerVolumeEffectEditor.field.Teleport.UseRotation.tooltip = [TMP] Apply the configured Rotation after teleporting. When off, the entity keeps its current rotation.
triggerVolumeEffectEditor.field.Teleport.Rotation.tooltip = [TMP] Yaw, pitch, and roll in degrees used when Use Rotation is enabled.
triggerVolumeEffectEditor.field.SendMessage.Message.tooltip = [TMP] Message sent to the triggering player.
triggerVolumeEffectEditor.field.PlaySound.SoundEvent.tooltip = [TMP] Sound event asset to play.
triggerVolumeEffectEditor.field.PlaySound.Volume.tooltip = [TMP] Sound playback volume multiplier.
triggerVolumeEffectEditor.field.PlaySound.Pitch.tooltip = [TMP] Sound playback pitch multiplier.
triggerVolumeEffectEditor.field.SetVelocity.Velocity.tooltip = [TMP] Velocity applied to the triggering entity.
triggerVolumeEffectEditor.field.SetVelocity.Additive.tooltip = [TMP] Add this velocity to the entity's current velocity instead of replacing it.
triggerVolumeEffectEditor.field.SetVelocity.RelativeMode.tooltip = [TMP] Interpret Velocity as world-space, horizontal-facing-relative, or full-look-relative.
triggerVolumeEffectEditor.field.PermissionCondition.Permission.tooltip = [TMP] Required permission node for the triggering player.
triggerVolumeEffectEditor.field.CooldownCondition.Cooldown.tooltip = [TMP] Seconds between accepted triggers. 0 disables the cooldown.
triggerVolumeEffectEditor.field.CooldownCondition.Scope.tooltip = [TMP] Per Player tracks each player separately. Whole Volume shares one timer for the condition.
triggerVolumeEffectEditor.field.GameModeCondition.GameMode.tooltip = [TMP] Required game mode for the triggering player.
triggerVolumeEffectEditor.field.ItemCondition.Item.tooltip = [TMP] Required item id.
triggerVolumeEffectEditor.field.ItemCondition.Location.tooltip = [TMP] Where to check for the item.
triggerVolumeEffectEditor.field.ItemCondition.Quantity.tooltip = [TMP] Minimum matching item quantity required.
triggerVolumeEffectEditor.field.ItemCondition.Consume.tooltip = [TMP] Remove the matching item quantity when this condition passes.
triggerVolumeEffectEditor.field.RandomChanceCondition.Chance.tooltip = [TMP] Acceptance chance from 0 to 1.
triggerVolumeEffectEditor.field.PlayerCountCondition.Comparison.tooltip = [TMP] How the live player count is compared against the configured value.
triggerVolumeEffectEditor.field.PlayerCountCondition.Count.tooltip = [TMP] Number of players to compare against. Counts every player currently inside this volume, or every player across the group on group-level events.
triggerVolumeEffectEditor.field.TagCondition.Source.tooltip = [TMP] Where to check for the tag: the tag event payload, this volume, the current group/spatial set, or a radius search.
triggerVolumeEffectEditor.field.TagCondition.TagKey.tooltip = [TMP] Tag key required on the selected source, or the event tag key when Source is Event.
triggerVolumeEffectEditor.field.TagCondition.TagValue.tooltip = [TMP] Optional tag value required under Tag Key. Blank matches any value for that key.
triggerVolumeEffectEditor.field.TagCondition.MatchKey.tooltip = [TMP] Used only when Source is Radius. Optional tag key used to choose candidate volumes. Blank includes every volume in the radius.
triggerVolumeEffectEditor.field.TagCondition.MatchValue.tooltip = [TMP] Used only when Source is Radius. Optional value required under Match Tag Key. Blank matches any value for that key.
triggerVolumeEffectEditor.field.TagCondition.Radius.tooltip = [TMP] Used only when Source is Radius. Maximum distance from the chosen center. 0 searches the entire world.
triggerVolumeEffectEditor.field.TagCondition.Center.tooltip = [TMP] Used only when Source is Radius. Center position used for the radius search.
triggerVolumeEffectEditor.field.TagCondition.MinimumCount.tooltip = [TMP] Used only when Source is Group or Radius. If greater than 0, this many candidate volumes must have Tag Key instead of requiring every candidate volume.
triggerVolumeEffectEditor.field.BlockTypeCondition.BlockType.tooltip = [TMP] Block type assets accepted by the block event. Use the picker multiple times to add more than one.
triggerVolumeEffectEditor.field.EntityEffect.Effect.tooltip = [TMP] Entity effect asset to apply or remove.
triggerVolumeEffectEditor.field.EntityEffect.Mode.tooltip = [TMP] Whether to add, remove, or toggle the entity effect.
triggerVolumeEffectEditor.field.EntityEffect.Duration.tooltip = [TMP] Duration in seconds for temporary entity effects.
triggerVolumeEffectEditor.field.TriggerNpcMarkers.MarkerType.tooltip = [TMP] NPC marker type to trigger. Leave empty to trigger every manual marker found in the area.
triggerVolumeEffectEditor.field.TriggerNpcMarkers.Range.tooltip = [TMP] Extra search radius around each area volume's origin, in blocks. 0 only triggers markers that lie inside the volume shape; any value above 0 also triggers markers within this sphere.
triggerVolumeEffectEditor.field.TriggerNpcMarkers.MatchTag.tooltip = [TMP] Optional tag used to pick which volumes act as the search area. Empty uses this volume (or every member volume on group-level events).
triggerVolumeEffectEditor.field.TriggerNpcMarkers.Radius.tooltip = [TMP] Filters Match Tag volumes to those within this distance of Center, in blocks. 0 includes every tagged volume in the world.
triggerVolumeEffectEditor.field.TriggerNpcMarkers.Center.tooltip = [TMP] What Radius is measured from: this trigger volume's origin or the triggering entity's position.
triggerVolumeEffectEditor.field.PlayVfx.ParticleSystem.tooltip = [TMP] Particle system asset to spawn.
triggerVolumeEffectEditor.field.PlayVfx.Offset.tooltip = [TMP] Offset from the entity or volume position.
triggerVolumeEffectEditor.field.PlayVfx.AtEntity.tooltip = [TMP] Spawn at the triggering entity instead of the volume origin.
triggerVolumeEffectEditor.field.PlayVfx.Scale.tooltip = [TMP] Visual scale multiplier. 1.0 is default.
triggerVolumeEffectEditor.field.PlayVfx.Rotation.tooltip = [TMP] Yaw/pitch/roll in degrees applied to the particle system.
triggerVolumeEffectEditor.field.PlayVfx.Duration.tooltip = [TMP] Auto-despawn after this many seconds. 0 lets the particle system run until it ends naturally.
triggerVolumeEffectEditor.field.SetWeather.Weather.tooltip = [TMP] Weather asset to apply.
triggerVolumeEffectEditor.field.SetWeather.PlayerOnly.tooltip = [TMP] Apply this weather only to the triggering player.
triggerVolumeEffectEditor.field.SetWeather.ResetWeather.tooltip = [TMP] Reset the weather instead of applying a new weather asset.
triggerVolumeEffectEditor.field.ShowEventTitle.PrimaryTitle.tooltip = [TMP] Main title text shown to the player.
triggerVolumeEffectEditor.field.ShowEventTitle.SecondaryTitle.tooltip = [TMP] Subtitle text shown below the main title.
triggerVolumeEffectEditor.field.ShowEventTitle.IsMajor.tooltip = [TMP] Use the major event title presentation.
triggerVolumeEffectEditor.field.ShowEventTitle.Icon.tooltip = [TMP] Optional icon asset shown with the title.
triggerVolumeEffectEditor.field.ShowEventTitle.Duration.tooltip = [TMP] Time in seconds the title remains visible.
triggerVolumeEffectEditor.field.ShowEventTitle.FadeInDuration.tooltip = [TMP] Fade-in duration in seconds.
triggerVolumeEffectEditor.field.ShowEventTitle.FadeOutDuration.tooltip = [TMP] Fade-out duration in seconds.
