triggerVolumeInspector.field.id.tooltip = [TMP] Unique id for this trigger volume or group.
triggerVolumeInspector.field.shape.tooltip = [TMP] Change the shape of this trigger volume.
triggerVolumeInspector.field.position.tooltip = [TMP] World position used by this trigger volume or group.
triggerVolumeInspector.field.dimensions.tooltip = [TMP] Size values for this trigger volume. Box uses half extents, sphere uses radius, cylinder uses radius and height.
triggerVolumeInspector.field.color.tooltip = [TMP] The color used to display this volume in the editor. Has no gameplay effect.
triggerVolumeInspector.field.targetTypes.tooltip = [TMP] Which entities can activate this volume. Player means only players, NPC means only NPCs, All means both.
triggerVolumeInspector.field.projectileSource.tooltip = [TMP] Which entity effects use when this volume is triggered by a projectile.
triggerVolumeInspector.field.enabled.tooltip = [TMP] Whether this trigger volume or group is active.
triggerVolumeInspector.field.keepLoaded.tooltip = [TMP] When enabled, the chunk containing this volume stays loaded in memory even when no players are nearby.
triggerVolumeInspector.field.cancelDelayedOnExit.tooltip = [TMP] When on (default), pending delayed Enter/Tick effects are cancelled when the entity leaves. When off, queued effects continue to fire even after the entity leaves the volume.
triggerVolumeInspector.field.activationDelay.tooltip = [TMP] How many seconds to wait after an entity enters before any effects (individual or group) start firing. Set to 0 for immediate activation.
triggerVolumeInspector.field.cooldown.tooltip = [TMP] Minimum seconds between activations. While on cooldown, entering the volume does nothing. Set to 0 to disable.
triggerVolumeInspector.field.cooldownMode.tooltip = [TMP] Per Player: each player has their own cooldown timer. Total: one shared timer for everyone.
triggerVolumeInspector.field.conditionTiming.tooltip = [TMP] Choose whether conditions are checked immediately or after the volume-wide delay.
triggerVolumeInspector.field.rejectionDelayMode.tooltip = [TMP] Choose whether rejection effects fire immediately when conditions fail or reuse the volume activation delay.
triggerVolumeInspector.field.members.tooltip = [TMP] Volumes that currently belong to this group.
