pageTitle = Creative Tools
introText = This is the hub from which you can access various tools and editors that can aid in the creation of content in Hytale.\n\
\n\
Simply choose one of the tools from the menu above to get started.
notification.noBlockTargeted = You need to target a block to open it in the Asset Editor.
modal.blockbench.installRequired.title = Blockbench Installation Required
modal.blockbench.installRequired.text = We are using Blockbench for 3D model editing. It seems like you don't have Blockbench installed.\n\nIt is only possible to launch Blockbench from Hytale if you installed Blockbench using the installer. \n\nWould you like to install it now from their website?
modal.blockbench.installRequired.confirm = Install Blockbench
modal.blockbench.pluginRequired.title = Hytale Plugin Required
modal.blockbench.pluginRequired.text = It seems like you have Blockbench installed, but the Hytale plugin is missing.\n\nPlease install the Hytale plugin. You can find the instructions for doing so on the Blockbench website.
modal.blockbench.pluginRequired.confirm = Show Install Instructions
modal.blockbench.launchFailed.title = Failed to Launch Blockbench
modal.blockbench.launchFailed.text = Blockbench was found on your system, but we were unable to launch it.\n\nPlease try launching Blockbench manually.
