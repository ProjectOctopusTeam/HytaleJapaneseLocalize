legend.SculptBrush.Page2.Intro = How surrounding blocks are weighted during smoothing.
legend.SculptBrush.Page2.Normal.Name = Normal
legend.SculptBrush.Page2.Normal.Description = Faces weighted most, edges less, corners least.
legend.SculptBrush.Page2.Uniform.Name = Uniform
legend.SculptBrush.Page2.Uniform.Description = All 26 neighbors weighted equally.
legend.SculptBrush.Page2.Gaussian.Name = Gaussian
