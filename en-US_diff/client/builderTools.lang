settings.FlightInertia.name = Flight Drift
settings.FlightInertia.description = Adds momentum and gradual deceleration to creative flight (0 = instant stop, 100 = maximum drift)
settings.FlightMode.name = Flight Mode
settings.FlightMode.description = Choose between hovering in place or flying toward camera direction
settings.DisplayLegend.name = Display Legend
settings.DisplayLegend.description = Shows or hides the builder tools legend panel with control hints
settings.NoClip.name = No Collision
