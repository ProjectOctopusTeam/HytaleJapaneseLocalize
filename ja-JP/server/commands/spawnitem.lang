desc = Spawn an item
item.desc = The item to spawn
quantity.desc = The quantity of items to spawn (default: 1)
count.desc = How many item entities to spawn
force.desc = The force multiplier for throwing items (default: 1.0)
spawned = Spawned {quantity}x {item}
spawnedMultiple = Spawned {count} item entities with {quantity}x {item} each (total: {total}x {item})
