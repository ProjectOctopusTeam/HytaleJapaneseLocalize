desc = サーバー認証を管理する
status.desc = 現在の認証状態を表示する
status.format = === サーバー認証ステータス ===\n\
    接続認証：{connectionMode}\n\
    トークンソース：{tokenMode}\n\
    プロファイル：{profile}\n\
    セッショントークン：{sessionToken}\n\
    IDトークン：{identityToken}\n\
    有効期限：{expiry}\n\
    証明書：{certificate}
status.remaining = 残り{hours}:{minutes}:{seconds}
status.expired = 期限切れ
status.certificate.unknown = 不明
status.certificate.notLoaded = 読み込まれていません
status.connectionMode.authenticated = 認証済み（mTLS + JWT）
status.connectionMode.offline = オフライン
status.connectionMode.insecure = 安全でない（開発用）
status.mode.none = 未認証
status.mode.singleplayer = シングルプレイヤー
status.mode.external = 外部セッション
status.mode.oauthBrowser = OAuthブラウザー
status.mode.oauthDevice = OAuthデバイス
status.mode.oauthStore = OAuthストア
status.tokenPresent = あり
status.tokenMissing = なし
status.help = '/auth login browser'または'/auth login device'を使用して認証してください。
status.pending = プロファイルの選択が必要です。'/auth select <number>'を使用して選択してください：
login.desc = サーバーを認証する
login.singleplayer = シングルプレイヤーモードではログインできません。トークンはクライアントから提供されます。
login.alreadyAuthenticated = サーバーはすでに認証されています。先に'/auth logout'を実行してください。
login.browser.desc = OAuth2ブラウザーフローを開始する（ローカルサーバー向け）
login.browser.starting = OAuth2ブラウザーフローを開始中。URLはブラウザーまたはコンソールを確認してください。
login.browser.success = 認証に成功しました！詳細は'/auth status'で確認してください。
login.browser.failed = ブラウザー認証に失敗しました。サーバーログを確認してください。
login.device.desc = OAuth2デバイスフローを開始する（ヘッドレス/リモートサーバー向け）
login.device.starting = OAuth2デバイスフローを開始中。確認URLはコンソールを確認してください。
login.device.success = 認証に成功しました！詳細は'/auth status'で確認してください。
login.device.failed = デバイス認証に失敗しました。サーバーログを確認してください。
login.pending = 複数のプロファイルが利用可能です。'/auth select <number>'を使用して選択してください：
logout.desc = サーバーの認証情報をクリアする
logout.singleplayer = シングルプレイヤーモードではログアウトできません。
logout.notAuthenticated = サーバーは現在認証されていません。
logout.success = サーバーからログアウトしました。以前のモード：{previousMode}
select.desc = 複数のプロファイルが利用可能な場合にゲームプロファイルを選択する
select.noPending = プロファイル選択の待機がありません。先に'/auth login'を実行してください。
select.success = プロファイルを選択しました！詳細は'/auth status'で確認してください。
select.failed = 選択したプロファイルでの認証完了に失敗しました。
select.availableProfiles = 利用可能なプロファイル：
select.usage = '/auth select <number>'または'/auth select <username>'を使用してください
select.profileItem = [{index, number}] {username}（{uuid}）
select.profile.desc = 選択するプロファイル番号またはユーザー名
select.variant.desc = 番号またはユーザー名でプロファイルを選択する
cancel.desc = アクティブなログインフローをキャンセルする
cancel.singleplayer = シングルプレイヤーモードでは適用されません。
cancel.success = アクティブなログインフローをキャンセルしました。
cancel.nothing = キャンセルするアクティブなログインフローがありません。
persistence.desc = 認証情報の保存方法を表示または変更する
persistence.singleplayer = シングルプレイヤーモードでは適用されません。
persistence.current = 認証情報の保存方法：{type}
persistence.changed = 認証情報の保存方法を{type}に変更しました
persistence.available = 利用可能なタイプ：{types}
persistence.type.desc = 保存タイプ（例：Memory、File）
persistence.variant.desc = 認証情報の保存方法を変更する
login.persistence.memory = 警告：認証情報はメモリのみに保存されています。再起動時に失われます！\n\
    認証情報を永続化するには：/auth persistence <type>\n\
    利用可能なタイプ：{types}
login.persistence.saved = 認証情報を{type}で保存しました
