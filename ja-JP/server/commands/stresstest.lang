desc = Server stress testing
start.desc = Start stress testing
start.name.desc = The name prefix for the stress test
start.initcount.desc = The initial number of bots to spawn
start.initcount.default = 0
start.interval.desc = The interval in seconds between adding new bots
start.interval.default = 30
start.dumptype.desc = The type of dump to perform (new_bot, interval, finish, never)
start.dumptype.default = interval
start.dumpinterval.desc = The interval in seconds between dumps (when dumptype is interval)
start.dumpinterval.default = 300
start.threshold.desc = The threshold in milliseconds for stopping the stress test
start.percentile.desc = The percentile to use for threshold checking (0.0-1.0)
start.percentile.default = 0.95
start.viewradius.desc = The view radius in blocks for each bot
start.viewradius.default = Default player view radius
start.radius.desc = The radius in blocks for bot movement
start.radius.default = Default player view radius * 2
start.yheight.desc = The Y height for bot spawning
start.yheight.default = 125
start.yheightmax.desc = The maximum Y height for bot movement
start.flySpeed.desc = The fly speed in blocks per second for bots
start.flySpeed.default = 8
start.shutdown.desc = Shutdown the server when the stress test finishes
stop.desc = Stop stress testing
started = Started stress test
stopped = Stopped stress test
alreadyStarted = Stress test already started
notStarted = Stress test not started
invalidName = Invalid name '{name}' (must be alphanumeric)
