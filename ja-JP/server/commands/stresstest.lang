desc = サーバーのストレステスト
start.desc = ストレステストを開始します
start.name.desc = ストレステストの名前プレフィックス
start.initcount.desc = 最初にスポーンするボットの数
start.initcount.default = 0
start.interval.desc = 新しいボットを追加する間隔（秒）
start.interval.default = 30
start.dumptype.desc = 実行するダンプの種類（new_bot、interval、finish、never）
start.dumptype.default = interval
start.dumpinterval.desc = ダンプ間隔（秒）（dumptypeがintervalの場合）
start.dumpinterval.default = 300
start.threshold.desc = ストレステストを停止する閾値（ミリ秒）
start.percentile.desc = 閾値チェックに使用するパーセンタイル（0.0〜1.0）
start.percentile.default = 0.95
start.viewradius.desc = 各ボットの視野半径（ブロック単位）
start.viewradius.default = プレイヤーのデフォルト視野半径
start.radius.desc = ボット移動の半径（ブロック単位）
start.radius.default = プレイヤーのデフォルト視野半径 × 2
start.yheight.desc = ボットスポーンのY高さ
start.yheight.default = 125
start.yheightmax.desc = ボット移動の最大Y高さ
start.flySpeed.desc = ボットの飛行速度（ブロック/秒）
start.flySpeed.default = 8
start.shutdown.desc = ストレステスト終了時にサーバーをシャットダウンします
stop.desc = ストレステストを停止します
started = ストレステストを開始しました
stopped = ストレステストを停止しました
alreadyStarted = ストレステストはすでに開始されています
notStarted = ストレステストは開始されていません
invalidName = 無効な名前 '{name}' です（英数字のみ使用可能）
