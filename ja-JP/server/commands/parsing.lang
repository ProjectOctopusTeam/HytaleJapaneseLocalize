usage.header = {fullyQualifiedName}: {description} \n/{fullyQualifiedName} {listOfRequiredArgs}{requiresConfirmation}{requiredArgs}{optionalArgs}{defaultArgs}{flagArgs}{argTypes}{variants}{subcommands}
usage.requiresConfirmation = \nこのコマンドを実行するには "--confirm" フラグ引数の指定が必要です。実行前にコマンドを再確認してください
usage.flagArgs = \nフラグ引数: {args}
usage.defaultArgs = \nデフォルト値付き引数: {args}
usage.optionalArgs = \n任意引数: {args}
usage.requiredArgs = \n必須引数: {args}
usage.subcommands = {separator}{usage}
usage.subcommandSeparator = \n---------------------------------\n
error.commandCollectionSubcommandNotFound = サブコマンド "{subcommand}" が見つかりませんでした。もしかして次のコマンドですか?: {suggestions}
error.wrongNumberOfParametersForArgument = 引数 "{argument}" の値の数が正しくありません。期待値: {expected}、実際: {actual}、入力: "{input}"。
error.noPermissionForCommand = このコマンドを使用する権限がありません。
error.noPermissionForOptional = 引数 "{argument}" を使用する権限がありません。
error.unavailableInSingleplayer = このコマンドはシングルプレイヤーでは使用できません。
error.attemptedUnsafe = このコマンドを実行するには、確認のためフラグ引数 "--confirm" を指定する必要があります。
error.wrongNumberRequiredParameters = 必須引数の数が正しくありません。期待値: {expected}、実際: {actual}
error.notAList = リストを受け付けない引数に対して、値のリストが指定されています。引数名: {name}。
error.couldNotFindOptionalArgName = 名前または一意な省略形が "{input}" の任意引数が見つかりませんでした。
error.allArgumentsInListNeedSameLength = リスト内のすべての引数は同じ数の値を持つ必要があります。エラー: {error}。
error.noOptionalParameterToAddValueTo = 内部エラー: 任意引数を先に作成せずに、任意引数へ値を追加することはできません。
error.cantDoublePlaceSpecialTokens = 特殊トークンを隣り合わせに置くことはできません。
error.endCommandWithOpenList = リストを開いたままコマンドを終えることはできません。"{listEndToken}" で閉じてください。
error.tooManyListItems = 1つのリストに {amount} 個を超える項目を指定することはできません。
error.invalidEscape = 文字列の末尾に無効なエスケープがあります。位置: {index}。
error.invalidEscapeForSymbol = コマンド "{command}" の位置 {index} にある記号 {symbol} のエスケープが無効です。
error.cannotBeginListInsideList = 位置 {index} で、リストの内側から別のリストを開始することはできません。
error.cannotEndListWithoutStarting = 位置 {index} で、開始していないリストを終了することはできません。
error.unbalancedQuotes = 引用符を開始しましたが、閉じていません。
error.optionalArgRequiredIf = 任意引数 "{required}" が指定されていませんが、別の任意引数 "{requirer}" が指定されているため必須です。
error.optionalArgAvailableIf = 任意引数 "{available}" が指定されましたが、これは次の引数がすべて指定されている場合にのみ使用できます(未指定): {required}。
error.optionalArgAvailableIfAbsent = 任意引数 "{available}" が指定されましたが、これは次の引数がすべて指定されていない場合にのみ使用できます: {required}。
