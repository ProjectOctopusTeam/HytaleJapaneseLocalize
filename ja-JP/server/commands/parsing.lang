usage.header = {fullyQualifiedName}: {description} \n/{fullyQualifiedName} {listOfRequiredArgs}{requiresConfirmation}{requiredArgs}{optionalArgs}{defaultArgs}{flagArgs}{argTypes}{variants}{subcommands}
usage.requiresConfirmation = \nこのコマンドを実行するには"--confirm"フラグ引数を指定する必要があります。実行前にコマンドをよく確認してください
usage.flagArgs = \nフラグ引数：{args}
usage.defaultArgs = \nデフォルト値付き引数：{args}
usage.optionalArgs = \nオプション引数：{args}
usage.requiredArgs = \n必須引数：{args}
usage.subcommands = {separator}{usage}
usage.subcommandSeparator = \n---------------------------------\n
error.commandCollectionSubcommandNotFound = サブコマンド'{subcommand}'が見つかりません。以下のコマンドをお探しですか？：{suggestions}
error.wrongNumberOfParametersForArgument = 引数'{argument}'の引数数が正しくありません。期待値：{expected}、実際：{actual}、受け取った入力："{input}"。
error.noPermissionForCommand = このコマンドを使用する権限がありません。
error.noPermissionForOptional = 引数'{argument}'を使用する権限がありません。
error.unavailableInSingleplayer = このコマンドはシングルプレイヤーでは使用できません。
error.attemptedUnsafe = このコマンドの実行確認として"--confirm"フラグ引数を指定する必要があります。
error.wrongNumberRequiredParameters = 指定された必須引数の数が正しくありません。期待値：{expected}、実際：{actual}
error.notAList = リストを受け付けない引数にリスト形式の値を指定しました。引数名：{name}。
error.couldNotFindOptionalArgName = 名前または一意な略称'{input}'のオプション引数が見つかりません。
error.allArgumentsInListNeedSameLength = リスト内のすべての引数は同じ数の引数を持つ必要があります。エラー：{error}。
error.noOptionalParameterToAddValueTo = 内部エラー：オプション引数を作成せずに値を追加できません。
error.cantDoublePlaceSpecialTokens = 特殊トークンを連続して配置することはできません。
error.endCommandWithOpenList = リストを'{listEndToken}'で閉じずにコマンドを終了することはできません。
error.tooManyListItems = リストに{amount}個を超えるリスト項目を指定することはできません。
error.invalidEscape = 文字列の末尾（インデックス{index}）に無効なエスケープがあります。
error.invalidEscapeForSymbol = コマンド"{command}"のインデックス{index}にある記号{symbol}に対する無効なエスケープです。
error.cannotBeginListInsideList = インデックス{index}でリストの中からリストを開始することはできません。
error.cannotEndListWithoutStarting = インデックス{index}でリストを開始せずに終了することはできません。
error.unbalancedQuotes = 引用符を開始しましたが、閉じていません。
error.optionalArgRequiredIf = オプション引数'{required}'が指定されていませんが、別のオプション引数'{requirer}'が指定されているため必須です。
error.optionalArgAvailableIf = オプション引数'{available}'が指定されていますが、以下の引数がすべて指定されている場合のみ使用可能です（未指定）：{required}。
error.optionalArgAvailableIfAbsent = オプション引数'{available}'が指定されていますが、以下の引数がすべて指定されていない場合のみ使用可能です：{required}。
