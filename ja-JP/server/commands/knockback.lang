desc = [TMP] エンティティにテスト用ノックバックを適用します。
apply.desc = [TMP] 方向プリセットを使用してノックバックコンポーネントを適用します。
apply.self.desc = [TMP] 自分自身にノックバックを適用します。
apply.aimed.desc = [TMP] 照準を合わせているエンティティにノックバックを適用します。
apply.direction.desc = [TMP] 水平方向：left|l、right|r、forward|f、backward|b。
apply.y.desc = [TMP] Y方向の速度値。
apply.force.desc = [TMP] 水平方向の力の値。
apply.preset.desc = [TMP] 速度設定プリセット：null、linear、exp、def。
apply.success = [TMP] ノックバックを適用しました（方向：{direction}、Y：{y}、力：{force}、プリセット：{preset}）。
apply.invalidDirection = [TMP] 無効な方向「{direction}」です。次のいずれかを指定してください：{values}。
apply.invalidPreset = [TMP] 無効なプリセット「{preset}」です。次のいずれかを指定してください：{values}。
